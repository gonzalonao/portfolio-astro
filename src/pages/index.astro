---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SkillBadge from '../components/SkillBadge.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CallToAction from '../components/CallToAction.astro';
import FadeIn from '../components/FadeIn.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';

const featured = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const skillGroups = [
  {
    title: 'BI & Visualization',
    color: 'teal' as const,
    skills: ['Power BI (Advanced)', 'DAX', 'Power Query (M)', 'Microsoft Fabric', 'Excel'],
  },
  {
    title: 'Data Engineering',
    color: 'blue' as const,
    skills: ['Azure Data Factory', 'Databricks', 'PySpark', 'Medallion Architecture', 'Pentaho PDI', 'Celonis'],
  },
  {
    title: 'AI / LLM / Deep Learning',
    color: 'purple' as const,
    skills: ['RAG', 'LangChain', 'OpenAI API', 'HuggingFace', 'PyTorch', 'PyTorch Geometric', 'scikit-learn', 'GNNs (GCN, GAT)', 'LSTM'],
  },
  {
    title: 'Programming & Trading Infra',
    color: 'orange' as const,
    skills: ['Python', 'pandas', 'asyncio', 'aiohttp', 'Selenium', 'BeautifulSoup', 'Rotating proxies', 'numpy', 'SQL', 'JavaScript', 'C'],
  },
  {
    title: 'Cloud',
    color: 'green' as const,
    skills: ['Azure Data Factory', 'Blob Storage', 'SQL Azure', 'Cosmos DB', 'Azure AD', 'Microsoft Fabric'],
  },
];
---

<BaseLayout>
  <Hero />

  {/* About */}
  <FadeIn>
    <section id="about" class="container-wide py-20">
      <div class="grid gap-10 md:grid-cols-[1.5fr_1fr]">
        <div>
          <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">About</h2>
          <div class="mt-6 space-y-4 text-base leading-relaxed text-ink-900/80 dark:text-[#c9d1d9]/80">
            <p>
              I'm a data professional with an unusual combination: a mathematical foundation from my Mathematics degree at UNED, the systems-level rigor of <strong>42 Málaga</strong> (where you write a Unix shell from scratch in C and ship real-time multiplayer in raw networking primitives), and a Master's in <strong>Big Data &amp; AI at ESESA</strong> covering ML, RAG with generative AI, Databricks/PySpark, and end-to-end Microsoft Fabric.
            </p>
            <p>
              My flagship project is a <strong>portfolio analytics &amp; trading automation system for the Steam Community Market</strong> — treating digital game items as a tradable asset class. It combines async Python (<code>asyncio</code> + <code>aiohttp</code>) with a rotating-proxy network for sub-second order placement, a Power Query / Excel BI layer that tracks realized P&amp;L and rolling ROI, and a scheduler that runs unattended trade rotations at off-peak hours. I forked and extended <code>steampy</code> to make this possible.
            </p>
            <p>
              On the BI side I work day-to-day with Power BI (DAX, Power Query M, semantic modeling), Microsoft Fabric, and Excel. My ML/DL focus has been deep learning for graph-structured problems — my Master's Thesis is a Spatio-Temporal Graph Neural Network (GCN/GAT + LSTM) predicting how flight delays cascade through the US airport network across 70M+ records.
            </p>
          </div>
        </div>

        <aside class="rounded-xl border border-ink-900/10 bg-white p-6 dark:border-white/10 dark:bg-white/[0.02]">
          <h3 class="font-display text-sm font-semibold uppercase tracking-wide text-ink-900/60 dark:text-[#c9d1d9]/60">Quick facts</h3>
          <dl class="mt-4 space-y-3 text-sm">
            <div class="flex items-start gap-2">
              <Icon name="lucide:map-pin" class="mt-0.5 h-4 w-4 text-accent-light dark:text-accent-dark" />
              <div>
                <dt class="text-ink-900/60 dark:text-[#c9d1d9]/60">Location</dt>
                <dd>Málaga, Spain</dd>
              </div>
            </div>
            <div class="flex items-start gap-2">
              <Icon name="lucide:languages" class="mt-0.5 h-4 w-4 text-accent-light dark:text-accent-dark" />
              <div>
                <dt class="text-ink-900/60 dark:text-[#c9d1d9]/60">Languages</dt>
                <dd>Spanish (native), English (C1)</dd>
              </div>
            </div>
            <div class="flex items-start gap-2">
              <Icon name="lucide:graduation-cap" class="mt-0.5 h-4 w-4 text-accent-light dark:text-accent-dark" />
              <div>
                <dt class="text-ink-900/60 dark:text-[#c9d1d9]/60">Currently studying</dt>
                <dd>Master's in Big Data & AI — ESESA</dd>
              </div>
            </div>
            <div class="flex items-start gap-2">
              <Icon name="lucide:briefcase" class="mt-0.5 h-4 w-4 text-accent-light dark:text-accent-dark" />
              <div>
                <dt class="text-ink-900/60 dark:text-[#c9d1d9]/60">Open to roles</dt>
                <dd>Data Analyst · BI Developer · Python Developer</dd>
              </div>
            </div>
          </dl>
        </aside>
      </div>
    </section>
  </FadeIn>

  {/* Skills */}
  <FadeIn>
    <section id="skills" class="container-wide py-16">
      <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">What I work with</h2>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {skillGroups.map((g) => (
          <div class="rounded-xl border border-ink-900/10 bg-white p-6 dark:border-white/10 dark:bg-white/[0.02]">
            <h3 class="font-display text-base font-semibold">{g.title}</h3>
            <div class="mt-4 flex flex-wrap gap-1.5">
              {g.skills.map((s) => <SkillBadge label={s} color={g.color} />)}
            </div>
          </div>
        ))}
      </div>
    </section>
  </FadeIn>

  {/* Featured projects */}
  <FadeIn>
    <section id="featured-projects" class="container-wide py-16">
      <div class="flex items-end justify-between">
        <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">Selected Work</h2>
        <a href="/projects" class="hidden text-sm font-medium text-accent-light hover:underline dark:text-accent-dark sm:inline-flex">
          View all projects →
        </a>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {featured.map((p) => (
          <ProjectCard
            href={`/projects/${p.slug}`}
            title={p.data.title}
            summary={p.data.summary}
            tags={p.data.tags}
            status={p.data.status}
          />
        ))}
      </div>
      <a href="/projects" class="mt-8 inline-flex text-sm font-medium text-accent-light hover:underline dark:text-accent-dark sm:hidden">
        View all projects →
      </a>
    </section>
  </FadeIn>

  <CallToAction />
</BaseLayout>
