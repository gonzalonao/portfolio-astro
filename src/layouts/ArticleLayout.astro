---
import BaseLayout from './BaseLayout.astro';
import TechTag from '../components/TechTag.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { getLang, t } from '../i18n';

export interface Props {
  entry: CollectionEntry<'writing'> | CollectionEntry<'writingEs'>;
  headings: { depth: number; slug: string; text: string }[];
}

const { entry, headings } = Astro.props;
const { data } = entry;

const lang = getLang(Astro.url);
const tArt = t[lang].article;
const tNav = t[lang].nav;

// Prev/next within the same-language writing collection, newest first.
const collectionName = lang === 'es' ? 'writingEs' : 'writing';
const all = (await getCollection(collectionName as 'writing'))
  .filter((a) => !a.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const idx = all.findIndex((a) => a.slug === entry.slug);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx < all.length - 1 ? all[idx + 1] : null;

const writingRoot = lang === 'es' ? '/es/writing' : '/writing';
const projectsRoot = lang === 'es' ? '/es/projects' : '/projects';
const homeRoot = lang === 'es' ? '/es/' : '/';

const dateLabel = data.date.toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${data.title} — Gonzalo López Crespo`} description={data.description}>
  {/* Breadcrumb */}
  <div class="container-wide pt-6 text-sm text-ink-900/60 dark:text-[#c9d1d9]/60">
    <a href={homeRoot} class="hover:text-ink-900 dark:hover:text-white">{tNav.home}</a>
    <span class="mx-1.5">/</span>
    <a href={writingRoot} class="hover:text-ink-900 dark:hover:text-white">{tArt.breadcrumbWriting}</a>
    <span class="mx-1.5">/</span>
    <span class="text-ink-900 dark:text-white">{data.title}</span>
  </div>

  {/* Hero band */}
  <header class="container-wide pt-8 pb-10">
    <p class="font-mono text-sm text-accent-light dark:text-accent-dark">
      {dateLabel} · {data.readingMinutes} {tArt.readTime}
    </p>
    <h1 class="mt-2 max-w-3xl font-display text-3xl font-bold tracking-tight sm:text-4xl">{data.title}</h1>
    <p class="mt-4 max-w-3xl text-lg text-ink-900/75 dark:text-[#c9d1d9]/75">{data.description}</p>
    {data.tags.length > 0 && (
      <div class="mt-5 flex flex-wrap items-center gap-2">
        {data.tags.map((tag) => <TechTag label={tag} />)}
      </div>
    )}
    {data.project && (
      <div class="mt-6">
        <a href={`${projectsRoot}/${data.project}`} class="btn-ghost">
          <Icon name="lucide:folder-git-2" class="h-4 w-4" /> {tArt.relatedProject}
        </a>
      </div>
    )}
  </header>

  {/* Main content + TOC */}
  <div class="container-wide grid grid-cols-1 gap-10 pb-16 lg:grid-cols-[1fr_220px]">
    <article class="prose prose-lg max-w-none dark:prose-invert">
      <slot />
    </article>

    <aside class="hidden lg:block">
      <div class="sticky top-20 text-sm">
        <p class="mb-3 font-display font-semibold uppercase tracking-wide text-ink-900/60 dark:text-[#c9d1d9]/60">{tArt.tableOfContents}</p>
        <ul class="space-y-2 border-l border-ink-900/10 dark:border-white/10">
          {headings.filter((h) => h.depth === 2 || h.depth === 3).map((h) => (
            <li>
              <a
                href={`#${h.slug}`}
                class:list={[
                  'block border-l-2 border-transparent py-0.5 pl-3 -ml-px text-ink-900/70 hover:border-accent-light hover:text-ink-900 dark:text-[#c9d1d9]/70 dark:hover:border-accent-dark dark:hover:text-white',
                  h.depth === 3 && 'pl-6 text-xs',
                ]}
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
        <a href={writingRoot} class="mt-6 inline-flex items-center gap-1 text-sm text-accent-light dark:text-accent-dark">
          <Icon name="lucide:arrow-left" class="h-4 w-4" /> {tArt.breadcrumbWriting}
        </a>
      </div>
    </aside>
  </div>

  {/* Prev / Next */}
  <nav class="container-wide grid grid-cols-1 gap-4 pb-16 sm:grid-cols-2">
    {prev ? (
      <a href={`${writingRoot}/${prev.slug}`} class="rounded-xl border border-ink-900/10 p-5 transition-colors hover:border-accent-light dark:border-white/10 dark:hover:border-accent-dark">
        <p class="text-xs text-ink-900/60 dark:text-[#c9d1d9]/60">← {tArt.prev}</p>
        <p class="mt-1 font-display font-semibold">{prev.data.title}</p>
      </a>
    ) : <span></span>}
    {next ? (
      <a href={`${writingRoot}/${next.slug}`} class="rounded-xl border border-ink-900/10 p-5 text-right transition-colors hover:border-accent-light dark:border-white/10 dark:hover:border-accent-dark">
        <p class="text-xs text-ink-900/60 dark:text-[#c9d1d9]/60">{tArt.next} →</p>
        <p class="mt-1 font-display font-semibold">{next.data.title}</p>
      </a>
    ) : <span></span>}
  </nav>
</BaseLayout>
