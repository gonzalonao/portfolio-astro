---
export interface TimelineItem {
  title: string;
  org: string;
  period: string;
  description?: string;
  bullets?: string[];
}
export interface Props { items: TimelineItem[]; }
const { items } = Astro.props;
---

<ol class="relative ml-3 border-l border-ink-900/15 dark:border-white/15">
  {items.map((item) => (
    <li class="mb-10 ml-6">
      <span class="absolute -left-[7px] mt-1.5 h-3 w-3 rounded-full bg-accent-light ring-4 ring-white dark:bg-accent-dark dark:ring-[#0d1117]"></span>
      <h3 class="font-display text-base font-semibold text-ink-900 dark:text-white">{item.title}</h3>
      <p class="text-sm text-ink-900/70 dark:text-[#c9d1d9]/70">
        <span class="font-medium">{item.org}</span> · <span class="font-mono text-xs">{item.period}</span>
      </p>
      {item.description && <p class="mt-2 text-sm text-ink-900/75 dark:text-[#c9d1d9]/75">{item.description}</p>}
      {item.bullets && (
        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-ink-900/75 dark:text-[#c9d1d9]/75">
          {item.bullets.map((b) => <li>{b}</li>)}
        </ul>
      )}
    </li>
  ))}
</ol>
