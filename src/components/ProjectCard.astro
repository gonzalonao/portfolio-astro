---
import TechTag from './TechTag.astro';
import { Icon } from 'astro-icon/components';

export interface Props {
  href: string;
  title: string;
  summary: string;
  tags: string[];
  status?: 'completed' | 'in-progress';
}

const { href, title, summary, tags, status } = Astro.props;
---

<a
  href={href}
  class="group flex h-full flex-col rounded-xl border border-ink-900/10 bg-white p-6 transition-all hover:-translate-y-0.5 hover:border-accent-light hover:shadow-lg dark:border-white/10 dark:bg-white/[0.02] dark:hover:border-accent-dark dark:hover:bg-white/[0.04]"
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-display text-lg font-semibold text-ink-900 dark:text-white">{title}</h3>
    {status && (
      <span class:list={[
        'shrink-0 rounded-full px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide',
        status === 'completed'
          ? 'bg-emerald-50 text-emerald-700 dark:bg-emerald-400/10 dark:text-emerald-300'
          : 'bg-amber-50 text-amber-700 dark:bg-amber-400/10 dark:text-amber-300',
      ]}>
        {status === 'completed' ? 'Completed' : 'In progress'}
      </span>
    )}
  </div>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-900/70 dark:text-[#c9d1d9]/70">{summary}</p>
  <div class="mt-5 flex flex-wrap gap-1.5">
    {tags.slice(0, 6).map((t) => <TechTag label={t} />)}
  </div>
  <div class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-accent-light dark:text-accent-dark">
    Read case study
    <Icon name="lucide:arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
  </div>
</a>
