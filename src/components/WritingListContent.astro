---
import TechTag from './TechTag.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import { getLang, t } from '../i18n';

const lang = getLang(Astro.url);
const s = t[lang].writingPage;
const tArt = t[lang].article;

const collectionName = lang === 'es' ? 'writingEs' : 'writing';
const articles = (await getCollection(collectionName as 'writing'))
  .filter((a) => !a.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const root = lang === 'es' ? '/es/writing' : '/writing';

const fmtDate = (d: Date) =>
  d.toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
---

<section class="container-wide py-16">
  <h1 class="font-display text-4xl font-bold tracking-tight sm:text-5xl">{s.title}</h1>
  <p class="mt-4 max-w-2xl text-lg text-ink-900/75 dark:text-[#c9d1d9]/75">{s.intro}</p>

  {articles.length === 0 ? (
    <p class="mt-10 text-ink-900/60 dark:text-[#c9d1d9]/60">{s.empty}</p>
  ) : (
    <div class="mt-10 flex flex-col gap-6">
      {articles.map((a) => (
        <a
          href={`${root}/${a.slug}`}
          class="group rounded-xl border border-ink-900/10 bg-white p-6 transition-all hover:-translate-y-0.5 hover:border-accent-light hover:shadow-lg dark:border-white/10 dark:bg-white/[0.02] dark:hover:border-accent-dark dark:hover:bg-white/[0.04]"
        >
          <p class="font-mono text-xs text-ink-900/55 dark:text-[#c9d1d9]/55">
            {fmtDate(a.data.date)} · {a.data.readingMinutes} {tArt.readTime}
          </p>
          <h2 class="mt-2 font-display text-xl font-semibold text-ink-900 dark:text-white">{a.data.title}</h2>
          <p class="mt-2 text-sm leading-relaxed text-ink-900/70 dark:text-[#c9d1d9]/70">{a.data.description}</p>
          {a.data.tags.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-1.5">
              {a.data.tags.slice(0, 6).map((tag) => <TechTag label={tag} />)}
            </div>
          )}
          <div class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-accent-light dark:text-accent-dark">
            {lang === 'es' ? 'Leer artículo' : 'Read article'}
            <Icon name="lucide:arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
          </div>
        </a>
      ))}
    </div>
  )}
</section>
