---
import Hero from './Hero.astro';
import SkillBadge from './SkillBadge.astro';
import ProjectCard from './ProjectCard.astro';
import CallToAction from './CallToAction.astro';
import FadeIn from './FadeIn.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import { getLang, t } from '../i18n';

const lang = getLang(Astro.url);
const s = t[lang];

const collectionName = lang === 'es' ? 'projectsEs' : 'projects';
const featured = (await getCollection(collectionName as 'projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const projectsRoot = lang === 'es' ? '/es/projects' : '/projects';
---

<Hero />

{/* About */}
<FadeIn>
  <section id="about" class="container-wide pt-8 pb-16 sm:pt-12 sm:pb-20">
    <div class="grid gap-10 md:grid-cols-[1.5fr_1fr]">
      <div>
        <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">{s.about.heading}</h2>
        <div class="mt-6 space-y-4 text-base leading-relaxed text-ink-900/80 dark:text-[#c9d1d9]/80">
          {s.about.paragraphsHtml.map((p) => <p set:html={p} />)}
        </div>
      </div>

      <aside class="rounded-xl border border-ink-900/10 bg-white p-6 dark:border-white/10 dark:bg-white/[0.02]">
        <h3 class="font-display text-sm font-semibold uppercase tracking-wide text-ink-900/60 dark:text-[#c9d1d9]/60">{s.about.quickFactsTitle}</h3>
        <dl class="mt-4 space-y-3 text-sm">
          <div class="flex items-start gap-2">
            <Icon name="lucide:map-pin" class="mt-0.5 h-4 w-4 text-accent-light dark:text-accent-dark" />
            <div>
              <dt class="text-ink-900/60 dark:text-[#c9d1d9]/60">{s.about.location}</dt>
              <dd>{s.about.locationValue}</dd>
            </div>
          </div>
          <div class="flex items-start gap-2">
            <Icon name="lucide:languages" class="mt-0.5 h-4 w-4 text-accent-light dark:text-accent-dark" />
            <div>
              <dt class="text-ink-900/60 dark:text-[#c9d1d9]/60">{s.about.languages}</dt>
              <dd>{s.about.languagesValue}</dd>
            </div>
          </div>
          <div class="flex items-start gap-2">
            <Icon name="lucide:graduation-cap" class="mt-0.5 h-4 w-4 text-accent-light dark:text-accent-dark" />
            <div>
              <dt class="text-ink-900/60 dark:text-[#c9d1d9]/60">{s.about.studying}</dt>
              <dd>{s.about.studyingValue}</dd>
            </div>
          </div>
          <div class="flex items-start gap-2">
            <Icon name="lucide:briefcase" class="mt-0.5 h-4 w-4 text-accent-light dark:text-accent-dark" />
            <div>
              <dt class="text-ink-900/60 dark:text-[#c9d1d9]/60">{s.about.openTo}</dt>
              <dd>{s.about.openToValue}</dd>
            </div>
          </div>
        </dl>
      </aside>
    </div>
  </section>
</FadeIn>

{/* Skills */}
<FadeIn>
  <section id="skills" class="container-wide py-16">
    <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">{s.skills.heading}</h2>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {s.skills.groups.map((g) => (
        <div class="rounded-xl border border-ink-900/10 bg-white p-6 dark:border-white/10 dark:bg-white/[0.02]">
          <h3 class="font-display text-base font-semibold">{g.title}</h3>
          <div class="mt-4 flex flex-wrap gap-1.5">
            {g.skills.map((sk) => <SkillBadge label={sk} color={g.color as any} />)}
          </div>
        </div>
      ))}
    </div>
  </section>
</FadeIn>

{/* Featured projects */}
<FadeIn>
  <section id="featured-projects" class="container-wide py-16">
    <div class="flex items-end justify-between">
      <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">{s.featured.heading}</h2>
      <a href={projectsRoot} class="hidden text-sm font-medium text-accent-light hover:underline dark:text-accent-dark sm:inline-flex">
        {s.featured.viewAll}
      </a>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {featured.map((p) => (
        <ProjectCard
          href={`${projectsRoot}/${p.slug}`}
          title={p.data.title}
          summary={p.data.summary}
          tags={p.data.tags}
          status={p.data.status}
        />
      ))}
    </div>
    <a href={projectsRoot} class="mt-8 inline-flex text-sm font-medium text-accent-light hover:underline dark:text-accent-dark sm:hidden">
      {s.featured.viewAll}
    </a>
  </section>
</FadeIn>

<CallToAction />
