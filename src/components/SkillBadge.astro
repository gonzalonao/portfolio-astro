---
export interface Props {
  label: string;
  color?: 'teal' | 'blue' | 'purple' | 'orange' | 'green';
}
const { label, color = 'teal' } = Astro.props;

const palette: Record<string, string> = {
  teal:   'bg-teal-50 text-teal-700 ring-teal-600/20 dark:bg-teal-400/10 dark:text-teal-300 dark:ring-teal-400/30',
  blue:   'bg-blue-50 text-blue-700 ring-blue-600/20 dark:bg-blue-400/10 dark:text-blue-300 dark:ring-blue-400/30',
  purple: 'bg-purple-50 text-purple-700 ring-purple-600/20 dark:bg-purple-400/10 dark:text-purple-300 dark:ring-purple-400/30',
  orange: 'bg-orange-50 text-orange-700 ring-orange-600/20 dark:bg-orange-400/10 dark:text-orange-200 dark:ring-orange-400/30',
  green:  'bg-emerald-50 text-emerald-700 ring-emerald-600/20 dark:bg-emerald-400/10 dark:text-emerald-300 dark:ring-emerald-400/30',
};
---

<span class:list={['inline-flex items-center rounded-full px-2.5 py-1 text-xs font-medium ring-1 ring-inset', palette[color]]}>
  {label}
</span>
