---
import { Icon } from 'astro-icon/components';
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle theme"
  class="inline-flex h-9 w-9 items-center justify-center rounded-md text-ink-900 hover:bg-ink-900/5 dark:text-white dark:hover:bg-white/5"
>
  <Icon name="lucide:sun" class="h-5 w-5 hidden dark:block" />
  <Icon name="lucide:moon" class="h-5 w-5 block dark:hidden" />
</button>

<script is:inline>
  (function () {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const isDark = root.classList.toggle('dark');
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch (_) {}
    });
  })();
</script>
