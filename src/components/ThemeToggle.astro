---
import { Icon } from 'astro-icon/components';
---

{/*
  This component is rendered twice in the Navbar (desktop + mobile).
  We use a `data-theme-toggle` selector (instead of an id) to avoid
  duplicate-id HTML and a `window.__themeToggleInit` flag so the inlined
  script only binds listeners once even when the component is included
  more than once on the page.
*/}
<button
  type="button"
  data-theme-toggle
  aria-label="Toggle theme"
  class="inline-flex h-9 w-9 items-center justify-center rounded-md text-ink-900 hover:bg-ink-900/5 dark:text-white dark:hover:bg-white/5"
>
  <Icon name="lucide:sun" class="h-5 w-5 hidden dark:block" />
  <Icon name="lucide:moon" class="h-5 w-5 block dark:hidden" />
</button>

<script is:inline>
  (function () {
    if (window.__themeToggleInit) return;
    window.__themeToggleInit = true;
    const buttons = document.querySelectorAll('[data-theme-toggle]');
    if (!buttons.length) return;
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const root = document.documentElement;
        const isDark = root.classList.toggle('dark');
        try {
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        } catch (_) {}
      });
    });
  })();
</script>
