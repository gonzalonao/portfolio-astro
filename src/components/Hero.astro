---
import { Icon } from 'astro-icon/components';
import { getLang, t } from '../i18n';

const lang = getLang(Astro.url);
const s = t[lang].hero;
const phrases = [...s.roles];
const cvHref = lang === 'es' ? '/cv-es.pdf' : '/cv.pdf';
const cvFilename = lang === 'es' ? 'CV_Gonzalo_Lopez_Crespo_ES.pdf' : 'CV_Gonzalo_Lopez_Crespo_EN.pdf';
---

<section class="relative isolate overflow-hidden">
  {/* Light gradient (light mode) */}
  <div class="absolute inset-0 -z-10 light-glow dark:hidden"></div>
  {/* Dot grid (dark mode) */}
  <div class="absolute inset-0 -z-10 hidden dark:block dot-grid opacity-60"></div>

  <div class="container-wide flex flex-col pt-20 pb-20 sm:pt-28 sm:pb-24">
    <p class="mb-3 font-mono text-sm text-accent-light dark:text-accent-dark">{s.greeting}</p>
    <h1 class="font-display text-5xl font-bold tracking-tight sm:text-6xl md:text-7xl">
      Gonzalo López Crespo
    </h1>
    <p class="mt-4 text-lg text-ink-900/80 dark:text-[#c9d1d9]/80 sm:text-xl">
      <span id="role-typer" class="font-medium text-ink-900 dark:text-white"></span><span class="caret ml-0.5">|</span>
    </p>
    <p
      class="mt-6 max-w-2xl text-base leading-relaxed text-ink-900/75 dark:text-[#c9d1d9]/75 sm:text-lg"
      set:html={s.subtitleHtml}
    />

    <div class="mt-9 flex flex-wrap gap-3">
      <a href="#featured-projects" class="btn-primary">
        <Icon name="lucide:folder" class="h-4 w-4" />
        {s.ctaProjects}
      </a>
      <a href={cvHref} download={cvFilename} class="btn-ghost">
        <Icon name="lucide:download" class="h-4 w-4" />
        {s.ctaCv}
      </a>
      <a href="https://github.com/gonzalonao/" target="_blank" rel="noopener noreferrer" class="btn-ghost">
        <Icon name="lucide:github" class="h-4 w-4" />
        {s.ctaGh}
      </a>
    </div>
  </div>
</section>

<style>
  .caret {
    display: inline-block;
    color: theme('colors.accent.light');
    animation: blink 1.05s step-end infinite;
  }
  :global(.dark) .caret { color: #58a6ff; }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
</style>

<script is:inline define:vars={{ phrases }}>
  (function () {
    const el = document.getElementById('role-typer');
    if (!el) return;
    let pi = 0, ci = 0, deleting = false;
    function tick() {
      const phrase = phrases[pi];
      if (!deleting) {
        ci++;
        el.textContent = phrase.slice(0, ci);
        if (ci === phrase.length) { deleting = true; setTimeout(tick, 1600); return; }
      } else {
        ci--;
        el.textContent = phrase.slice(0, ci);
        if (ci === 0) { deleting = false; pi = (pi + 1) % phrases.length; }
      }
      setTimeout(tick, deleting ? 35 : 65);
    }
    tick();
  })();
</script>
