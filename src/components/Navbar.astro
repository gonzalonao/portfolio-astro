---
import ThemeToggle from './ThemeToggle.astro';
import { Icon } from 'astro-icon/components';

const links = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/education', label: 'Education' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-40 border-b border-ink-900/10 bg-white/80 backdrop-blur-md dark:border-white/10 dark:bg-[#0d1117]/80">
  <nav class="container-wide flex h-16 items-center justify-between">
    <a href="/" class="font-display text-lg font-semibold tracking-tight">
      <span class="text-accent-light dark:text-accent-dark">G.</span>López Crespo
    </a>

    <ul class="hidden items-center gap-7 md:flex">
      {links.map((l) => {
        const active = (l.href === '/' && currentPath === '/') || (l.href !== '/' && currentPath.startsWith(l.href));
        return (
          <li>
            <a
              href={l.href}
              class:list={[
                'text-sm transition-colors',
                active
                  ? 'text-accent-light dark:text-accent-dark'
                  : 'text-ink-900/80 hover:text-ink-900 dark:text-[#c9d1d9]/80 dark:hover:text-white',
              ]}
            >
              {l.label}
            </a>
          </li>
        );
      })}
      <li><ThemeToggle /></li>
    </ul>

    <div class="flex items-center gap-2 md:hidden">
      <ThemeToggle />
      <button
        id="nav-toggle"
        type="button"
        aria-label="Toggle navigation"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="rounded-md p-2 text-ink-900 hover:bg-ink-900/5 dark:text-white dark:hover:bg-white/5"
      >
        <Icon name="lucide:menu" class="h-5 w-5 nav-icon-open" />
        <Icon name="lucide:x" class="h-5 w-5 nav-icon-close hidden" />
      </button>
    </div>
  </nav>

  <div id="mobile-nav" class="hidden border-t border-ink-900/10 bg-white px-4 py-3 dark:border-white/10 dark:bg-[#0d1117] md:hidden">
    <ul class="flex flex-col gap-3">
      {links.map((l) => (
        <li>
          <a href={l.href} class="block py-1 text-sm text-ink-900 dark:text-[#c9d1d9]">{l.label}</a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script is:inline>
  (function () {
    const btn = document.getElementById('nav-toggle');
    const menu = document.getElementById('mobile-nav');
    if (!btn || !menu) return;
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      menu.classList.toggle('hidden');
      btn.querySelector('.nav-icon-open')?.classList.toggle('hidden');
      btn.querySelector('.nav-icon-close')?.classList.toggle('hidden');
    });
  })();
</script>
