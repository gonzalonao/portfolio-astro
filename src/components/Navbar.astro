---
import ThemeToggle from './ThemeToggle.astro';
import { Icon } from 'astro-icon/components';
import { getLang, t, altLangPath } from '../i18n';

const lang = getLang(Astro.url);
const tNav = t[lang].nav;

const base = lang === 'es' ? '/es' : '';

const links = [
  { href: `${base}/` || '/', label: tNav.home },
  { href: `${base}/projects`, label: tNav.projects },
  { href: `${base}/education`, label: tNav.education },
  { href: `${base}/contact`, label: tNav.contact },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const otherLang = lang === 'es' ? 'en' : 'es';
const altHref = altLangPath(Astro.url.pathname, otherLang);
---

<header class="sticky top-0 z-40 border-b border-ink-900/10 bg-white/80 backdrop-blur-md dark:border-white/10 dark:bg-[#0d1117]/80">
  <nav class="container-wide flex h-16 items-center justify-between">
    <a href={base ? `${base}/` : '/'} class="font-display text-lg font-medium tracking-tight text-ink-900 dark:text-white">
      Gonzalo López
    </a>

    <ul class="hidden items-center gap-7 md:flex">
      {links.map((l) => {
        const normalized = l.href.replace(/\/$/, '') || '/';
        const active = (normalized === (base || '/') && currentPath === (base || '/')) ||
                       (normalized !== (base || '/') && currentPath.startsWith(normalized));
        return (
          <li>
            <a
              href={l.href}
              class:list={[
                'text-sm transition-colors',
                active
                  ? 'text-accent-light dark:text-accent-dark'
                  : 'text-ink-900/80 hover:text-ink-900 dark:text-[#c9d1d9]/80 dark:hover:text-white',
              ]}
            >
              {l.label}
            </a>
          </li>
        );
      })}
      <li>
        <a
          href={altHref}
          aria-label={tNav.toggleLangAria}
          class="inline-flex items-center gap-1 rounded-md border border-ink-900/10 px-2 py-1 font-mono text-xs uppercase tracking-wide text-ink-900/70 transition-colors hover:border-accent-light hover:text-ink-900 dark:border-white/10 dark:text-[#c9d1d9]/70 dark:hover:border-accent-dark dark:hover:text-white"
        >
          <Icon name="lucide:globe" class="h-3.5 w-3.5" />
          {otherLang === 'es' ? 'ES' : 'EN'}
        </a>
      </li>
      <li><ThemeToggle /></li>
    </ul>

    <div class="flex items-center gap-2 md:hidden">
      <a
        href={altHref}
        aria-label={tNav.toggleLangAria}
        class="rounded-md border border-ink-900/10 px-2 py-1 font-mono text-xs uppercase tracking-wide text-ink-900/70 hover:text-ink-900 dark:border-white/10 dark:text-[#c9d1d9]/70 dark:hover:text-white"
      >
        {otherLang === 'es' ? 'ES' : 'EN'}
      </a>
      <ThemeToggle />
      <button
        id="nav-toggle"
        type="button"
        aria-label="Toggle navigation"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="rounded-md p-2 text-ink-900 hover:bg-ink-900/5 dark:text-white dark:hover:bg-white/5"
      >
        <Icon name="lucide:menu" class="h-5 w-5 nav-icon-open" />
        <Icon name="lucide:x" class="h-5 w-5 nav-icon-close hidden" />
      </button>
    </div>
  </nav>

  <div id="mobile-nav" class="hidden border-t border-ink-900/10 bg-white px-4 py-3 dark:border-white/10 dark:bg-[#0d1117] md:hidden">
    <ul class="flex flex-col gap-3">
      {links.map((l) => (
        <li>
          <a href={l.href} class="block py-1 text-sm text-ink-900 dark:text-[#c9d1d9]">{l.label}</a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script is:inline>
  (function () {
    const btn = document.getElementById('nav-toggle');
    const menu = document.getElementById('mobile-nav');
    if (!btn || !menu) return;
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      menu.classList.toggle('hidden');
      btn.querySelector('.nav-icon-open')?.classList.toggle('hidden');
      btn.querySelector('.nav-icon-close')?.classList.toggle('hidden');
    });
  })();
</script>
